---
import { withBase } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langs, text, type Lang } from '../../config';
export function getStaticPaths() { return langs.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
---
<BaseLayout lang={lang} active="about" title={text[lang].about} translationPath={withBase(`/${lang === 'zh' ? 'en' : 'zh'}/about/`)}>
  <header class="standard-heading"><p class="eyebrow">A LITTLE ABOUT THIS SPACE</p><h1>{text[lang].about}</h1></header>
  <div class="prose about-prose">
    {lang === 'zh' ? <><p>这里是 Xiang's Blog，一个记录个人想法的地方。我会写一些读过的东西、感兴趣的问题和日常观察；其中有些与学术有关，也有些没有。这里不限定主题，也不要求每篇文章都得出完整结论。</p><p>文章通常先用中文写作。部分文章会由我自己翻译成英文，因此两种语言的内容和更新时间可能不同。</p></> : <><p>This is Xiang's Blog, a place for personal writing. I'll post about things I've read, questions that interest me, and observations from everyday life. Some posts will be academic; others won't. Not every piece needs to reach a firm conclusion.</p><p>I usually write in Chinese first and translate some posts into English myself. The two language versions may appear or be updated at different times.</p></>}
  </div>
</BaseLayout>
