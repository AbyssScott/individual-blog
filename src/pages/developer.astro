---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { withBase } from '../lib/urls';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="referrer" content="no-referrer" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src https://api.github.com; base-uri 'none'; form-action 'none'; object-src 'none'" />
  <title>Developer Mode · Xiang's Blog</title>
</head>
<body>
<main class="dev" data-pagefind-ignore data-base={withBase('/')}>
<header class="studio-top"><div><strong>Xiang's Blog</strong><span class="muted"> / Developer Studio</span></div><div class="bar"><a href={withBase('/zh/')}>返回博客</a><button id="theme" type="button">切换主题</button></div></header>
<section id="login" class="login-card"><h1>开发者模式</h1><p>管理文章、草稿与发布。</p><label for="token">GitHub access token</label><input id="token" type="password" autocomplete="off" spellcheck="false" placeholder="github_pat_…" /><button id="connect" class="primary" type="button">登录</button><p class="muted">令牌只保存在当前页面内存中。<a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer">管理令牌</a></p></section>
<section id="workspace" hidden>
<div class="session bar"><span id="identity"></span><span id="draft-state" aria-live="polite"></span><button id="logout" type="button">退出登录</button></div>
<div class="studio-layout">
<aside class="panel library"><div class="bar between"><h2>文章库</h2><button id="new" type="button">＋ 新建</button></div><input id="search-post" type="search" placeholder="搜索文章标题" aria-label="搜索文章" /><div class="bar filters"><button data-filter="all" aria-pressed="true">全部</button><button data-filter="zh" aria-pressed="false">中文</button><button data-filter="en" aria-pressed="false">English</button></div><nav id="post-list" aria-label="文章列表"></nav><select id="posts" hidden aria-label="文章"></select><button id="open" hidden type="button">打开</button></aside>
<section class="panel writing"><header class="bar between writing-header"><div><span id="language" class="muted">文章编辑</span><h1 id="article-title">选择文章</h1><p id="path" class="muted"></p></div><button id="publish" class="primary" type="button">保存并发布</button></header>
<div class="bar toolbar"><button id="edit" aria-pressed="true">正文编辑</button><button id="split-mode" aria-pressed="false">实时分栏</button><button id="preview-button" aria-pressed="false">预览</button><button id="raw-mode" aria-pressed="false">完整源码</button></div>
<div class="bar toolbar" id="format-bar"><button data-format="h2">H2</button><button data-format="h3">H3</button><button data-format="bold"><b>B</b></button><button data-format="italic"><i>I</i></button><button data-format="quote">引用</button><button data-format="list">列表</button><button data-format="link">链接</button><button data-format="math">公式</button><button data-format="blockmath">公式块</button><button data-format="code">代码</button><button data-format="footnote">脚注</button><button id="pick-image">图片</button></div>
<div id="editor-grid" data-mode="body"><textarea id="body-editor" rows="26" spellcheck="false" aria-label="Markdown 正文"></textarea><textarea id="source" hidden rows="26" spellcheck="false" aria-label="完整 Markdown 源码"></textarea><article id="preview" class="prose article-body" hidden></article></div>
<footer class="bar between toolbar"><span id="word-count" class="muted"></span><span class="muted">Markdown · LaTeX</span><button id="download">下载草稿</button></footer></section>
<aside class="panel details"><h2>文章属性</h2><label for="meta-title">标题</label><input id="meta-title" /><label for="meta-description">摘要</label><textarea id="meta-description" rows="3"></textarea><label for="meta-date">发布日期</label><input id="meta-date" type="date" /><label for="meta-tags">标签（逗号分隔）</label><input id="meta-tags" /><label for="meta-key">中英文关联键</label><input id="meta-key" /><p id="meta-notice" class="muted"></p><button id="counterpart" disabled>打开另一语言版本</button><a id="view-post" target="_blank" rel="noopener noreferrer" hidden>查看正式文章</a>
<details id="image-details"><summary>图片资源</summary><p class="muted">上传后立即公开。支持粘贴或拖放图片。</p><input id="image-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" /><button id="upload">上传并插入</button><select id="images" aria-label="已有图片"></select><button id="insert-image">插入已有图片</button></details>
<details><summary>版本与发布</summary><button id="history-button">历史版本</button><section id="history" hidden><select id="versions" aria-label="历史版本"></select><button id="restore">载入选中版本</button></section><button id="check" disabled>检查发布状态</button><a href="https://github.com/AbyssScott/individual-blog/actions/workflows/deploy.yml" target="_blank" rel="noopener noreferrer">发布记录</a></details>
<details><summary>危险操作</summary><button id="remove">删除文章</button></details></aside>
</div></section><p id="status" role="status" aria-live="polite"></p></main>
<script src="../scripts/developer.js"></script></body></html>
<style>
.dev{width:100%;max-width:1800px;margin:auto;padding:0 clamp(12px,2vw,28px) 24px;font:14px/1.5 var(--body-font)}.studio-top,.bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.studio-top,.between{justify-content:space-between}.studio-top{height:auto;min-height:64px;border-bottom:1px solid var(--line)}.studio-top strong{font-size:19px;color:var(--heading)}.session{min-height:48px;justify-content:space-between}.session #draft-state{flex:1;text-align:center}.studio-layout{display:grid;grid-template-columns:minmax(190px,240px) minmax(0,1fr) minmax(210px,270px);gap:14px;align-items:start}.panel,.login-card{border:1px solid var(--line);border-radius:12px;background:var(--surface);min-width:0}.library,.details{padding:15px;position:sticky;top:12px;max-height:calc(100vh - 24px);overflow:auto}.writing{overflow:hidden}.writing-header{padding:18px;align-items:flex-start}.writing-header>div{min-width:0;flex:1}.writing-header h1{font-size:clamp(19px,2vw,26px);margin:6px 0;color:var(--heading);overflow-wrap:anywhere}.dev h2{font-size:15px;margin:0;color:var(--heading)}.dev p{margin:6px 0}.muted{font-size:12px;color:var(--secondary);overflow-wrap:anywhere}.dev a{color:var(--accent)}.dev label{display:block;font-weight:600;margin:12px 0 5px}.dev button,.dev input,.dev select,.dev textarea{font:inherit;background:var(--surface);color:var(--fg);border:1px solid var(--line);border-radius:7px;padding:7px 9px;min-width:0;max-width:100%}.dev button:hover,.dev button[aria-pressed=true]{background:var(--accent-soft);color:var(--accent)}.dev button:disabled{opacity:.45;cursor:default}.dev .primary{background:#2563eb;color:#fff;border-color:#2563eb;font-weight:600}.dev .primary:hover{background:#1d4ed8;color:#fff}.library input,.details input,.details textarea,.details select{width:100%}.library input{margin:14px 0 8px}.filters button{flex:1}.library nav{display:flex;flex-direction:column;gap:4px;margin-top:12px}.library nav .group{font-size:11px;color:var(--secondary);font-weight:700;margin-top:12px}.library nav button{text-align:left;border-color:transparent;overflow-wrap:anywhere}.library nav button[aria-current=true]{background:var(--accent-soft);color:var(--accent);border-color:var(--line)}.library nav small{display:block;color:var(--secondary);font-size:11px}.toolbar{padding:8px 12px;border-top:1px solid var(--line)}.toolbar button{padding:5px 8px}.writing #editor-grid{display:grid;border-top:1px solid var(--line);min-width:0}.writing #editor-grid[data-mode=split]{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.writing #editor-grid textarea{width:100%;min-height:65vh;resize:vertical;border:0;border-radius:0;padding:20px;font:14px/1.8 ui-monospace,Consolas,monospace;background:var(--bg)}.writing #preview{margin:0;min-width:0;max-width:none;overflow:auto;overflow-wrap:anywhere;padding:20px;min-height:65vh;max-height:85vh}.writing #editor-grid[data-mode=split] #preview{border-left:1px solid var(--line)}.details>button,.details>a,.details details button,.details details a{display:block;width:100%;text-align:left;margin:8px 0}.details details{border-top:1px solid var(--line);padding-top:12px;margin-top:14px}.details summary{cursor:pointer;font-weight:600}.login-card{max-width:460px;margin:10vh auto;padding:32px}.login-card h1{font-size:28px;color:var(--heading)}.login-card input,.login-card button{display:block;width:100%;margin:10px 0}.dev #status{position:sticky;bottom:8px;background:var(--surface);border:1px solid var(--line);padding:10px;border-radius:8px;overflow-wrap:anywhere}.dev #status:empty{display:none}.dev #status[data-error=true],#remove{color:#b85035}.dev [hidden]{display:none!important}
@media(max-width:1120px){.studio-layout{grid-template-columns:200px minmax(0,1fr)}.details{grid-column:2;position:static;max-height:none}.library{grid-row:span 2}}
@media(max-width:700px){.studio-layout{display:flex;flex-direction:column}.library,.details,.writing{width:100%;position:static;max-height:none}.library nav{max-height:220px;overflow:auto}.writing #editor-grid[data-mode=split]{grid-template-columns:1fr}}
</style>
