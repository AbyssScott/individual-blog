---
import { formatDate, postPath, type Post } from '../lib/posts';
import type { Lang } from '../config';
interface Props { posts: Post[]; lang: Lang; }
const { posts, lang } = Astro.props;
---
<div class="post-list">
  {posts.map((post) => (
    <article class="post-teaser">
      <div class="post-meta"><time datetime={post.data.date.toISOString().slice(0,10)}>{formatDate(post.data.date, lang)}</time>{post.data.tags.length > 0 && <span class="meta-divider">/</span>}{post.data.tags.length > 0 && <span>{post.data.tags.join(' · ')}</span>}</div>
      <h2><a href={postPath(post)}>{post.data.title}</a></h2>
      <p>{post.data.description}</p>
    </article>
  ))}
</div>
