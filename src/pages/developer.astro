---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { withBase } from '../lib/urls';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="referrer" content="no-referrer" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src https://api.github.com; base-uri 'none'; form-action 'none'; object-src 'none'" />
  <title>Developer Mode · Xiang's Blog</title>
</head>
<body>
<main class="dev" data-pagefind-ignore data-base={withBase('/')}>
  <header class="dev-top"><h1>Developer Mode</h1><a href={withBase('/zh/')}>返回博客</a></header>
  <section id="login">
    <h2>管理员验证</h2>
    <p>仅接受仓库所有者的 GitHub fine-grained token。令牌只保留在当前页面的内存中，直接发送给 GitHub API，不写入仓库或浏览器存储。</p>
    <label for="token">GitHub access token</label>
    <input id="token" type="password" autocomplete="off" spellcheck="false" placeholder="github_pat_…" />
    <button id="connect" type="button">进入开发者模式</button>
    <p>需要 <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer">创建 fine-grained token</a>：仅限 individual-blog，Contents: Read and write。Actions: Read 可用于检查发布状态。</p>
  </section>
  <section id="workspace" hidden>
    <div class="dev-bar"><span id="identity"></span><button id="logout" type="button">退出</button></div>
    <label for="posts">文章（中英文独立）</label>
    <div class="dev-bar"><select id="posts"></select><button id="open" type="button">打开</button><button id="new" type="button">新建</button></div>
    <p id="path"></p>
    <div class="dev-bar">
      <button id="edit" type="button">Markdown 编辑</button><button id="preview-button" type="button">渲染预览</button>
      <button id="history-button" type="button">历史版本</button><button id="download" type="button">下载草稿</button>
    </div>
    <textarea id="source" rows="24" spellcheck="false" aria-label="文章 Markdown（含 YAML 元数据）"></textarea>
    <article id="preview" class="prose article-body" hidden></article>
    <p id="draft-state" aria-live="polite"></p>
    <div class="dev-bar"><button id="publish" type="button">保存并发布</button><button id="remove" type="button">删除文章</button><button id="check" type="button" disabled>检查发布状态</button><a href="https://github.com/AbyssScott/individual-blog/actions/workflows/deploy.yml" target="_blank" rel="noopener noreferrer">发布记录</a></div>
    <section id="history" hidden><h2>历史版本</h2><select id="versions"></select><button id="restore" type="button">载入选中版本（尚不发布）</button></section>
    <section><h2>图片</h2><p>上传图片会立即写入公开仓库。不要上传私人图片；删除图片可能破坏已有文章。</p>
      <div class="dev-bar"><input id="image-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" /><button id="upload" type="button">上传并插入引用</button></div>
      <div class="dev-bar"><select id="images"></select><button id="insert-image" type="button">插入已有图片</button></div>
    </section>
  </section>
  <p id="status" role="status" aria-live="polite"></p>
</main>
<script src="../scripts/developer.js"></script>
</body>
</html>
<style>
.dev{max-width:1050px;margin:2rem auto;padding:0 1rem;font-family:system-ui,sans-serif}
.dev-top,.dev-bar{display:flex;align-items:center;gap:.65rem;flex-wrap:wrap;margin:.65rem 0}
.dev-top{justify-content:space-between}
.dev h1{margin:0;font-size:1.8rem}.dev h2{font-size:1.15rem;margin:1.4rem 0 .5rem}
.dev p{margin:.65rem 0;line-height:1.6}.dev label{display:block;margin:.75rem 0 .3rem;font-weight:600}
.dev input,.dev select,.dev textarea,.dev button{font:inherit;color:inherit;background:transparent;border:1px solid currentColor;border-radius:6px;padding:.55rem .75rem}
.dev textarea{width:100%;box-sizing:border-box;font:14px/1.65 ui-monospace,monospace;resize:vertical}
.dev select{max-width:100%;flex:1;min-width:12rem}.dev input[type=password]{width:min(100%,34rem);box-sizing:border-box}
.dev button{cursor:pointer}.dev button:disabled{opacity:.5;cursor:default}
.dev [hidden]{display:none!important}.dev #preview{border:1px solid currentColor;padding:1rem;overflow-wrap:anywhere}
.dev #status,.dev #draft-state{white-space:pre-wrap;overflow-wrap:anywhere}.dev #status[data-error=true]{color:#b85035}
.dev #publish{background:#1757a8;color:white;border-color:#1757a8}.dev #remove{color:#b85035}
</style>
