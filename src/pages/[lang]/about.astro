---
import { withBase } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langs, text, type Lang } from '../../config';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---
<BaseLayout lang={lang} active="about" title={text[lang].about} translationPath={withBase(`/${lang === 'zh' ? 'en' : 'zh'}/about/`)}>
  <header class="standard-heading">
    <p class="eyebrow">ABOUT THIS BLOG</p>
    <h1>{text[lang].about}</h1>
  </header>
  <div class="prose about-prose">
    {lang === 'zh' ? (
      <>
        <p>欢迎！这里是我的个人博客。</p>
        <p>在这里，我主要会写一些平时生活中感兴趣的事情，以及它们偶尔与社会科学、因果推断碰撞出来的突发奇想。很多时候，这些想法可能有些“登不上大雅之堂”，大概也写不成什么严肃的学术论文。但我总觉得，它们本身还是有价值的。而且，花些时间把这些想法继续琢磨下去、写下来，也能帮助我锻炼学术思考和研究设计的能力。于是，我决定把它们放在这里。</p>
        <p>你可能会在这里看到不少尚不成熟、奇奇怪怪，甚至让人哭笑不得的想法和文章。</p>
        <p>但，嘿，这是我的博客！我说了算！</p>
      </>
    ) : (
      <>
        <p>Welcome! This is my personal blog.</p>
        <p>Here, I mostly write about things that catch my interest in everyday life, along with the unexpected ideas that come up when they intersect with social science and causal inference. Many of these ideas probably aren't quite fit for the academic stage, and they're unlikely to become serious papers. But I still think they're worth exploring. Taking the time to think them through and write them down also helps me develop my academic thinking and research design skills. So I've decided to put them here.</p>
        <p>You might find plenty of half-formed, strange, or even downright ridiculous ideas and posts on this blog.</p>
        <p>But hey, it's my blog! I make the rules!</p>
      </>
    )}
  </div>
</BaseLayout>
