---
import { config, text, otherLang, type Lang } from '../config';
import { withBase } from '../lib/urls';
interface Props { lang: Lang; active?: string; translationPath?: string | null; }
const { lang, active = '', translationPath } = Astro.props;
const t = text[lang];
const fallbackPath = withBase(`/${otherLang(lang)}/`);
const switchPath = translationPath ?? fallbackPath;
---
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={withBase(`/${lang}/`)} aria-label={`${config.name[lang]} — ${t.home}`}>{config.name[lang]}<span class="wordmark-dot">.</span></a>
    <nav class="main-nav" aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
      <a href={withBase(`/${lang}/`)} aria-current={active === 'home' ? 'page' : undefined}>{t.home}</a>
      <a href={withBase(`/${lang}/archive/`)} aria-current={active === 'archive' ? 'page' : undefined}>{t.archive}</a>
      <a href={withBase(`/${lang}/tags/`)} aria-current={active === 'tags' ? 'page' : undefined}>{t.tags}</a>
      <a href={withBase(`/${lang}/about/`)} aria-current={active === 'about' ? 'page' : undefined}>{t.about}</a>
      <a href={withBase(`/${lang}/search/`)} aria-current={active === 'search' ? 'page' : undefined} class="search-link" aria-label={t.search} title={t.search}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
      </a>
    </nav>
    <div class="header-actions">
      <a class="language-link" href={switchPath} data-language-switch={otherLang(lang)} title={translationPath ? (lang === 'zh' ? 'Read English version' : '阅读中文版本') : (lang === 'zh' ? 'Go to English homepage' : '前往中文首页')} aria-label={lang === 'zh' ? 'English' : '中文'}>{lang === 'zh' ? 'EN' : '中'}</a>
      <button type="button" id="theme-toggle" class="icon-button theme-button" aria-label={lang === 'zh' ? '切换深色或浅色模式' : 'Toggle light or dark theme'} title={lang === 'zh' ? '切换主题' : 'Toggle theme'}>
        <svg class="moon-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 13.2A8.6 8.6 0 0 1 10.8 3.5 8.8 8.8 0 1 0 20.5 13.2Z"/></svg>
        <svg class="sun-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3.7"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>
