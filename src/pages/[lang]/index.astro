---
import { withBase } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { config, text, langs, type Lang } from '../../config';
import { publishedPosts } from '../../lib/posts';
export function getStaticPaths() { return langs.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const posts = await publishedPosts(lang);
---
<BaseLayout lang={lang} active="home" translationPath={withBase(`/${lang === 'zh' ? 'en' : 'zh'}/`)}>
  <section class="hero">
    <p class="eyebrow">{lang === 'zh' ? 'PERSONAL WEBLOG' : 'A PERSONAL WEBLOG'}</p>
    <h1>{lang === 'zh' ? '写在这里。' : 'A place to write.'}</h1>
    <p class="hero-description">{config.description[lang]}</p>
  </section>
  <section class="section-spaced">
    <div class="section-header"><h2>{text[lang].recent}</h2><a href={withBase(`/${lang}/archive/`)}>{text[lang].allPosts}<span aria-hidden="true"> ↗</span></a></div>
    {posts.length ? <PostList posts={posts} lang={lang} /> : <p class="muted">{text[lang].empty}</p>}
  </section>
</BaseLayout>
