---
import { withBase } from '../../../lib/urls';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Comments from '../../../components/Comments.astro';
import { text, otherLang, type Lang } from '../../../config';
import { publishedPosts, postPath, tagPath, formatDate, type Post } from '../../../lib/posts';
import { render } from 'astro:content';

interface Props { post: Post; translationPath: string | null; }
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => {
    const counterpart = posts.find(
      (candidate) =>
        candidate.data.translationKey === post.data.translationKey &&
        candidate.data.lang === otherLang(post.data.lang as Lang)
    );
    return {
      params: { lang: post.data.lang, slug: post.id.split('/').slice(1).join('/') },
      props: { post, translationPath: counterpart ? postPath(counterpart) : null },
    };
  });
}
const { post, translationPath } = Astro.props;
const lang = post.data.lang as Lang;
const { Content } = await render(post);
---
<BaseLayout lang={lang} active="home" title={post.data.title} description={post.data.description} isPost={true} translationPath={translationPath} canonicalPath={postPath(post)}>
  <article class="post-page">
    <a href={withBase(`/${lang}/`)} class="back-link">← {text[lang].back}</a>
    <header class="article-heading">
      <time datetime={post.data.date.toISOString().slice(0,10)}>{formatDate(post.data.date, lang)}</time>
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      {post.data.description && <p class="article-summary">{post.data.description}</p>}
      <div class="article-tags">{post.data.tags.map((tag) => <a href={tagPath(lang, tag)}>{tag}</a>)}</div>
    </header>
    <div class="article-body prose" data-pagefind-body><Content /></div>
    <div class="post-endmark" aria-hidden="true">✳</div>
    <Comments lang={lang} translationKey={post.data.translationKey} />
  </article>
</BaseLayout>
