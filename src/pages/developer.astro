---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { withBase } from '../lib/urls';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="referrer" content="no-referrer" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src https://api.github.com; base-uri 'none'; form-action 'none'; object-src 'none'" />
  <title>Developer Mode · Xiang's Blog</title>
</head>
<body>
<main class="dev" data-pagefind-ignore data-base={withBase('/')}>
<header class="studio-top"><div class="studio-mark"><a href={withBase('/zh/')} class="brand-mark">X<span>.</span></a><div><strong>Xiang's Blog</strong><small>Writing studio</small></div></div><div class="bar top-actions"><a href={withBase('/zh/')}>查看博客 ↗</a><button id="theme" type="button" aria-label="切换浅色或深色主题" title="切换主题"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M20.8 14.1A9 9 0 0 1 9.9 3.2 9 9 0 1 0 20.8 14.1Z"/></svg></button></div></header>
<section id="login" class="login-card"><h1>开发者模式</h1><p>管理文章、草稿与发布。</p><label for="token">GitHub access token</label><input id="token" type="password" autocomplete="off" spellcheck="false" placeholder="github_pat_…" /><button id="connect" class="primary" type="button">登录</button><p class="muted">令牌只保存在当前页面内存中。<a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer">管理令牌</a></p></section>
<section id="workspace" hidden>
<div class="session bar"><span id="identity"></span><span id="draft-state" aria-live="polite"></span><button id="logout" type="button">退出登录</button></div>
<div class="studio-layout">
<aside class="panel library"><div class="bar between library-heading"><h2>文章</h2><button id="new" type="button" title="新建文章" aria-label="新建文章">＋</button></div><input id="search-post" type="search" placeholder="搜索文章标题" aria-label="搜索文章" /><div class="bar filters"><button data-filter="all" aria-pressed="true">全部</button><button data-filter="zh" aria-pressed="false">中文</button><button data-filter="en" aria-pressed="false">English</button></div><nav id="post-list" aria-label="文章列表"></nav><select id="posts" hidden aria-label="文章"></select><button id="open" hidden type="button">打开</button></aside>
<section class="panel writing"><header class="writing-header"><div class="bar between editor-topline"><span id="language" class="muted">文章编辑</span><div class="bar"><button id="toggle-library" type="button" title="显示或隐藏文章列表" aria-label="显示或隐藏文章列表">文章</button><button id="toggle-details" type="button" aria-pressed="true" title="显示或隐藏文章属性">属性</button><button id="publish" class="primary" type="button">发布 <span aria-hidden="true">↗</span></button></div></div><h1 id="article-title">选择文章</h1><p id="path" class="muted" hidden></p></header>
<div class="bar toolbar mode-tabs"><button id="edit" aria-pressed="true">写作</button><button id="split-mode" aria-pressed="false">分栏</button><button id="preview-button" aria-pressed="false">预览</button><button id="raw-mode" aria-pressed="false">源码</button></div>
<div class="bar toolbar" id="format-bar"><button data-format="h2">H2</button><button data-format="h3">H3</button><button data-format="bold"><b>B</b></button><button data-format="italic"><i>I</i></button><button data-format="quote">引用</button><button data-format="list">列表</button><button data-format="link">链接</button><button data-format="math">公式</button><button data-format="blockmath">公式块</button><button data-format="code">代码</button><button data-format="footnote">脚注</button><button id="pick-image">图片</button></div>
<div id="editor-grid" data-mode="body"><textarea id="body-editor" rows="26" spellcheck="false" aria-label="Markdown 正文"></textarea><textarea id="source" hidden rows="26" spellcheck="false" aria-label="完整 Markdown 源码"></textarea><article id="preview" class="prose article-body" hidden></article></div>
<footer class="bar between toolbar"><span id="word-count" class="muted"></span><span class="muted">Markdown · LaTeX</span><button id="download">下载草稿</button></footer></section>
<aside class="panel details"><div class="bar between inspector-heading"><h2>文章属性</h2><button id="close-details" type="button" aria-label="隐藏文章属性" title="隐藏文章属性">×</button></div><label for="meta-title">标题</label><input id="meta-title" /><label for="meta-description">摘要</label><textarea id="meta-description" rows="3"></textarea><label for="meta-date">发布日期</label><input id="meta-date" type="date" /><label for="meta-tags">标签（逗号分隔）</label><input id="meta-tags" /><details class="advanced"><summary>高级设置</summary><label for="meta-key">中英文关联键</label><input id="meta-key" /><p id="meta-notice" class="muted"></p></details><button id="counterpart" disabled>打开另一语言版本</button><a id="view-post" target="_blank" rel="noopener noreferrer" hidden>查看正式文章</a>
<details id="image-details"><summary>图片资源</summary><p class="muted">上传后立即公开。支持粘贴或拖放图片。</p><input id="image-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" /><button id="upload">上传并插入</button><select id="images" aria-label="已有图片"></select><button id="insert-image">插入已有图片</button></details>
<details><summary>版本与发布</summary><button id="history-button">历史版本</button><section id="history" hidden><select id="versions" aria-label="历史版本"></select><button id="restore">载入选中版本</button></section><button id="check" disabled>检查发布状态</button><a href="https://github.com/AbyssScott/individual-blog/actions/workflows/deploy.yml" target="_blank" rel="noopener noreferrer">发布记录</a></details>
<details><summary>危险操作</summary><button id="remove">删除文章</button></details></aside>
</div></section><p id="status" role="status" aria-live="polite"></p></main>
<script src="../scripts/developer.js"></script></body></html>
<style is:global>
/* Dynamic article-list nodes are created in JS, so this sheet is intentionally global but entirely .dev-namespaced. */
.dev{--studio-sidebar:#f7f9fc;--studio-hover:#edf1f7;--studio-selected:#e8efff;--studio-rule:#e6eaf0;--studio-input:#fff;--studio-blue:#2563eb;--studio-ink:#17263c;--studio-sub:#748197;width:100%;max-width:none;margin:0 auto;padding:0;font:14px/1.55 var(--body-font);color:var(--fg)}
:root[data-theme=dark] .dev{--studio-sidebar:#0c0c0c;--studio-hover:#161616;--studio-selected:#15263d;--studio-rule:#262626;--studio-input:#090909;--studio-blue:#93c5fd;--studio-ink:#f0f0f0;--studio-sub:#9a9a9a}
.dev *{box-sizing:border-box}.dev [hidden]{display:none!important}.dev button,.dev input,.dev textarea,.dev select{font:inherit;color:inherit;min-width:0;max-width:100%}.dev button{appearance:none;border:0;background:transparent;cursor:pointer;border-radius:6px;padding:6px 10px;line-height:1.4}.dev button:hover:not(:disabled){background:var(--studio-hover)}.dev button:disabled{opacity:.4;cursor:default}.dev a{color:var(--studio-blue);text-decoration:none}.dev a:hover{text-decoration:underline}.dev .bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.dev .between{justify-content:space-between}.dev h2{font-size:13px;font-weight:650;margin:0;color:var(--studio-ink)}.dev p{margin:6px 0}.dev .muted{font-size:12px;color:var(--studio-sub);overflow-wrap:anywhere}
.dev .studio-top{height:61px;display:flex;justify-content:space-between;align-items:center;padding:0 24px;border-bottom:1px solid var(--studio-rule);background:var(--bg)}.dev .studio-mark{display:flex;align-items:center;gap:12px}.dev .brand-mark{display:grid;place-items:center;width:33px;height:33px;border-radius:9px;background:#16253a;color:white;font:700 21px/1 Georgia,serif;letter-spacing:-3px;padding-right:3px;display:flex;justify-content:center;text-decoration:none}.dev .brand-mark span{color:#8dbaff}.dev .studio-mark strong{display:block;color:var(--studio-ink);font-size:14px;line-height:1.3}.dev .studio-mark small{font-size:10px;color:var(--studio-sub);letter-spacing:.08em;text-transform:uppercase}.dev .top-actions{gap:17px;font-size:12px}.dev #theme{display:grid;place-items:center;padding:7px}
.dev .session{height:35px;padding:0 24px;border-bottom:1px solid var(--studio-rule);background:var(--bg);font-size:11px;color:var(--studio-sub);gap:15px}.dev .session #identity{white-space:nowrap}.dev .session #draft-state{flex:1;text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.dev #logout{padding:3px 5px;font-size:11px}
.dev .studio-layout{display:grid;grid-template-columns:248px minmax(0,1fr) 248px;min-height:calc(100dvh - 96px);align-items:stretch}.dev .studio-layout.hide-details{grid-template-columns:248px minmax(0,1fr)}.dev .studio-layout.hide-library{grid-template-columns:minmax(0,1fr) 248px}.dev .studio-layout.hide-library.hide-details{grid-template-columns:minmax(0,1fr)}.dev .hide-details .details,.dev .hide-library .library{display:none}.dev .panel{min-width:0}.dev .library,.dev .details{position:sticky;top:0;align-self:start;height:calc(100dvh - 96px);overflow:auto;background:var(--studio-sidebar);padding:20px 15px;scrollbar-width:thin}.dev .library{border-right:1px solid var(--studio-rule)}.dev .details{border-left:1px solid var(--studio-rule);padding:20px 18px}.dev .library-heading{margin:0 2px 15px}.dev #new{font-size:19px;line-height:1;padding:4px 9px;color:var(--studio-blue);background:var(--studio-selected)}.dev #search-post,.dev .details input,.dev .details textarea,.dev .details select,.dev .login-card input{width:100%;background:var(--studio-input);border:1px solid var(--studio-rule);border-radius:6px;padding:9px 10px;outline:none}.dev #search-post:focus,.dev .details input:focus,.dev .details textarea:focus{border-color:var(--studio-blue)}.dev #search-post{font-size:12px;margin-bottom:10px}.dev .filters{gap:2px;padding:3px;border-radius:7px;background:var(--studio-hover)}.dev .filters button{flex:1;padding:5px 4px;font-size:11px;color:var(--studio-sub)}.dev .filters button[aria-pressed=true]{background:var(--studio-input);color:var(--studio-ink);font-weight:600;box-shadow:0 1px 3px #0000000a}
.dev #post-list{display:flex;flex-direction:column;gap:3px;margin-top:13px}.dev #post-list .group{display:block;margin:15px 9px 5px;color:var(--studio-sub);font-size:10px;letter-spacing:.05em;font-weight:650;text-transform:uppercase}.dev #post-list button{display:block;width:100%;text-align:left;background:transparent;border:0;border-radius:7px;line-height:1.45;padding:10px 10px 9px;font-size:12.5px;color:var(--fg);overflow-wrap:anywhere;position:relative}.dev #post-list button:hover{background:var(--studio-hover)}.dev #post-list button[aria-current=true]{background:var(--studio-selected);color:var(--studio-blue);font-weight:600}.dev #post-list button[aria-current=true]::before{content:"";position:absolute;left:0;top:10px;bottom:10px;width:2px;background:var(--studio-blue);border-radius:2px}.dev #post-list small{display:block;font-size:10px;font-weight:400;color:var(--studio-sub);margin-top:5px;font-variant-numeric:tabular-nums}
.dev .writing{background:var(--bg);display:flex;flex-direction:column;min-height:calc(100dvh - 96px)}.dev .writing-header{padding:22px clamp(24px,3vw,50px) 15px}.dev .editor-topline{margin-bottom:17px}.dev #language{font-size:11px;text-transform:uppercase;letter-spacing:.09em;font-weight:600}.dev .editor-topline button:not(.primary){font-size:12px;color:var(--studio-sub)}.dev .editor-topline button[aria-pressed=true]{color:var(--studio-blue);background:var(--studio-selected)}.dev .primary{background:#2563eb;color:#fff;border-radius:7px;font-weight:600;padding:8px 15px;box-shadow:0 1px 2px #00000010}.dev .primary:hover:not(:disabled){background:#1d4ed8;color:#fff}.dev #article-title{font-family:var(--reading-font);font-weight:600;line-height:1.22;letter-spacing:-.025em;font-size:clamp(24px,2.5vw,35px);margin:0;color:var(--studio-ink);overflow-wrap:anywhere}
.dev .toolbar{padding:8px clamp(16px,2.5vw,40px);gap:5px}.dev .mode-tabs{border-bottom:1px solid var(--studio-rule);gap:20px;padding-bottom:0}.dev .mode-tabs button{font-size:12px;color:var(--studio-sub);border-radius:0;padding:8px 0 11px;position:relative}.dev .mode-tabs button[aria-pressed=true]{color:var(--studio-blue);font-weight:600}.dev .mode-tabs button[aria-pressed=true]::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--studio-blue)}.dev #format-bar{border-bottom:1px solid var(--studio-rule);padding-top:7px;padding-bottom:7px}.dev #format-bar button{font-size:11px;min-width:25px;padding:5px 7px;color:var(--studio-sub)}.dev #format-bar button:nth-child(2),.dev #format-bar button:nth-child(4){margin-right:7px}.dev #format-bar button b{font-size:13px;color:var(--fg)}
.dev #editor-grid{display:grid;min-width:0;flex:1}.dev #editor-grid[data-mode=split]{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.dev #editor-grid textarea{appearance:none;width:100%;height:max(420px,calc(100dvh - 335px));resize:vertical;display:block;border:0;outline:0;border-radius:0;padding:24px clamp(22px,3.5vw,52px);font:16px/1.9 var(--reading-font);color:var(--fg);background:var(--bg);scrollbar-width:thin;tab-size:4}.dev #editor-grid #source{font:13px/1.8 ui-monospace,Consolas,monospace}.dev #editor-grid[data-mode=split] textarea{font-size:14px;padding:20px}.dev #preview{margin:0;min-width:0;max-width:none;overflow:auto;overflow-wrap:anywhere;padding:24px clamp(22px,3.5vw,52px);max-height:max(420px,calc(100dvh - 335px));scrollbar-width:thin}.dev #preview>h1{font-family:var(--reading-font);font-size:27px;line-height:1.3;margin:0 0 1em}.dev #editor-grid[data-mode=split] #preview{border-left:1px solid var(--studio-rule);padding:20px;font-size:14px}.dev .writing footer{border-top:1px solid var(--studio-rule);font-size:11px;margin-top:auto}.dev .writing footer button{font-size:11px}
.dev .inspector-heading{margin-bottom:21px}.dev #close-details{font-size:20px;line-height:1;color:var(--studio-sub);padding:2px 7px}.dev .details label,.dev .login-card label{display:block;font-size:11px;font-weight:600;color:var(--studio-sub);margin:15px 0 6px}.dev .details input,.dev .details textarea,.dev .details select{font-size:12px}.dev .details #meta-title{font-weight:500}.dev .details textarea{resize:vertical;min-height:64px}.dev .details>button,.dev .details>a,.dev .details details button,.dev .details details a{display:block;width:100%;text-align:left;font-size:12px;margin:8px 0}.dev .details>button{border:1px solid var(--studio-rule);background:var(--studio-input)}.dev .details>a{padding:3px 6px}.dev .details details{border-top:1px solid var(--studio-rule);padding-top:13px;margin-top:16px}.dev .details details.advanced{margin-top:13px}.dev .details summary{cursor:pointer;font-size:12px;font-weight:550;color:var(--fg)}.dev #remove{color:#b85035}
.dev .login-card{width:min(420px,calc(100% - 36px));margin:12vh auto;border:1px solid var(--studio-rule);border-radius:15px;padding:32px;background:var(--bg)}.dev .login-card h1{font-family:var(--reading-font);font-size:29px;color:var(--studio-ink);margin:0 0 10px}.dev .login-card .primary{width:100%;margin:14px 0}.dev #status{position:fixed;right:20px;bottom:18px;max-width:min(500px,calc(100vw - 40px));z-index:5;padding:10px 14px;margin:0;border:1px solid var(--studio-rule);background:var(--studio-input);border-radius:8px;box-shadow:0 6px 24px #0000000d;font-size:12px;overflow-wrap:anywhere}.dev #status:empty{display:none}.dev #status[data-error=true]{color:#b85035}
@media(min-width:1500px){.dev .studio-layout{grid-template-columns:275px minmax(0,1fr) 275px}.dev .studio-layout.hide-details{grid-template-columns:275px minmax(0,1fr)}.dev .studio-layout.hide-library{grid-template-columns:minmax(0,1fr) 275px}.dev .studio-layout.hide-library.hide-details{grid-template-columns:minmax(0,1fr)}}
@media(max-width:1100px){.dev .studio-layout{grid-template-columns:205px minmax(0,1fr) 215px}.dev .studio-layout.hide-details{grid-template-columns:205px minmax(0,1fr)}.dev .studio-layout.hide-library{grid-template-columns:minmax(0,1fr) 215px}.dev .studio-layout.hide-library.hide-details{grid-template-columns:minmax(0,1fr)}.dev .library,.dev .details{padding:15px 11px}.dev .writing-header{padding:20px 20px 12px}}
@media(max-width:820px){.dev .studio-layout,.dev .studio-layout.hide-details,.dev .studio-layout.hide-library,.dev .studio-layout.hide-library.hide-details{display:flex;flex-direction:column}.dev .library,.dev .details{position:static;height:auto;width:100%;border:0;border-bottom:1px solid var(--studio-rule)}.dev .library #post-list{max-height:200px;overflow:auto}.dev .writing{width:100%;min-height:0}.dev .studio-top,.dev .session{padding-left:12px;padding-right:12px}.dev #editor-grid[data-mode=split]{grid-template-columns:1fr}.dev #editor-grid[data-mode=split] #preview{border-left:0;border-top:1px solid var(--studio-rule)}.dev #editor-grid textarea{height:60vh}.dev #preview{max-height:none}.dev .studio-layout .details{order:3}}
</style>
